{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pachimanga",
  "version": "0.4.0",
  "identifier": "dev.frogilab.pachimanga",
  "build": {
    "frontendDist": "https://pachimanga.frogilab.dev"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Pachimanga",
        "width": 1280,
        "height": 820,
        "minWidth": 360,
        "minHeight": 640,
        "resizable": true
      }
    ],
    "security": {
      "capabilities": ["remote-pachimanga"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all"
  }
}
