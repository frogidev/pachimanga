# Copy to .env.local; replace the dummy values below with a Supabase project's
# actual URL and publishable key. Never use a service-role or secret key here.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME

# Optional server-only relay for WeebCentral web/PWA.
# Leave both values empty until a private, operation-limited relay is configured.
# Do not expose its bearer token using a NEXT_PUBLIC_ variable.
WEEBCENTRAL_RELAY_URL=
WEEBCENTRAL_RELAY_TOKEN=

# Optional public AniList OAuth application client ID.
# Configure the application callback: /tracking/anilist/callback
NEXT_PUBLIC_ANILIST_CLIENT_ID=

# Optional public MyAnimeList OAuth application client ID.
# Configure the application callback: /tracking/myanimelist/callback
NEXT_PUBLIC_MYANIMELIST_CLIENT_ID=

# Optional server-only secret when the registered MyAnimeList app requires it.
MYANIMELIST_CLIENT_SECRET=
