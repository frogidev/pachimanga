# Copy to .env.local; replace the dummy values below with a Supabase project's
# actual URL and publishable key. Never use a service-role or secret key here.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME

# Optional server-only relay for WeebCentral web/PWA.
# Leave both values empty until a private, operation-limited relay is configured.
# Do not expose its bearer token using a NEXT_PUBLIC_ variable.
WEEBCENTRAL_RELAY_URL=
WEEBCENTRAL_RELAY_TOKEN=

