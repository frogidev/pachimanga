NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional server-only private relay for WeebCentral web/PWA access.
# Never expose the relay token through a NEXT_PUBLIC_ variable.
WEEBCENTRAL_RELAY_URL=
WEEBCENTRAL_RELAY_TOKEN=

# Optional public AniList OAuth application client id.
# Configure the AniList application redirect URL as:
# https://pachimanga.frogilab.dev/tracking/anilist/callback
NEXT_PUBLIC_ANILIST_CLIENT_ID=
